{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krish-homes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/sitemap.xml"]
  },
  // D1 + R2 are auto-provisioned by Wrangler on first deploy (Workers Builds).
  // To use existing resources, add "database_id" / change bucket_name.
  "d1_databases": [
    { "binding": "DB", "database_name": "krish-homes-db", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "krish-homes-media" }],
  // Public (non-secret) runtime config. Set these in Cloudflare > Worker > Settings > Variables.
  "vars": {
    "FIREBASE_API_KEY": "",
    "FIREBASE_AUTH_DOMAIN": "",
    "FIREBASE_PROJECT_ID": "",
    "FIREBASE_APP_ID": "",
    "SUPER_ADMIN_EMAIL": "admin@krishhomes.in"
  }
  // Secrets (set with `wrangler secret put` or in the dashboard):
  //   SUPER_ADMIN_PASSWORD  - initial super admin password (otherwise "ChangeMe@123", forced change on first login)
  //   JWT_SECRET            - optional; auto-generated and stored in D1 when absent
}
